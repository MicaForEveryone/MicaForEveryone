<Page
    x:Class="MicaForEveryone.App.Views.AppSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MicaForEveryone.App.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel>
        <local:SettingsPageControl Header="General">
            <ToggleSwitch x:Name="StartupToggle" Header="Run on system startup" Toggled="StartupToggle_Toggled" IsEnabled="False" />
        </local:SettingsPageControl>

        <local:SettingsPageControl Header="About">
            <StackPanel>
                <TextBlock Text="{x:Bind ViewModel.AppVersion, Mode=OneWay}" />
                <Button Content="Check for updates" Command="{x:Bind ViewModel.CheckForUpdatesCommand}" />
            </StackPanel>
        </local:SettingsPageControl>

        <local:SettingsPageControl Header="Other Platforms">
            <StackPanel>
                <HyperlinkButton Content="Linktree Portfolio" NavigateUri="https://linktr.ee/saeedxdie"/>
                <HyperlinkButton Content="Gravatar WorldWide Profile" NavigateUri="https://gravatar.com/cheerfuld27b01881a"/>
                <HyperlinkButton Content="TSunGpt - 2" NavigateUri="https://tsungpt2.vercel.app/"/>
                <HyperlinkButton Content="TikTok Video Downloader By TSun Studio" NavigateUri="https://tsuntiktokdownloder.vercel.app/"/>
                <HyperlinkButton Content="TikTok Video Downloader 2" NavigateUri="https://tiktokdownloade.vercel.app/"/>
                <HyperlinkButton Content="TikTok Video Downloade 3" NavigateUri="https://tiktokdownloder.vercel.app/"/>
                <HyperlinkButton Content="Tsun | YOUTUBE DOWNLOADER" NavigateUri="https://tsun-yt-downloder.vercel.app/"/>
                <HyperlinkButton Content="Facebook video downloader" NavigateUri="https://facebookvideodownloader2.vercel.app"/>
            </StackPanel>
        </local:SettingsPageControl>

        <local:SettingsPageControl Header="Social Links">
            <StackPanel>
                <HyperlinkButton Content="GitHub" NavigateUri="https://github.com/SaeedX302"/>
                <HyperlinkButton Content="Twitter" NavigateUri="https://x.com/saeedx300"/>
                <HyperlinkButton Content="Instagram" NavigateUri="https://www.instagram.com/saeedxdie"/>
                <HyperlinkButton Content="Telegram" NavigateUri="https://t.me/saeedxdie"/>
                <HyperlinkButton Content="TikTok" NavigateUri="https://www.tiktok.com/@saeedxdie"/>
                <HyperlinkButton Content="YouTube" NavigateUri="https://www.youtube.com/@TsunMusicOfficial"/>
            </StackPanel>
        </local:SettingsPageControl>
    </StackPanel>
</Page>
