<Page
    x:Class="MicaForEveryone.App.Views.TrayIconPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Page.ContextFlyout>
        <MenuFlyout>
            <MenuFlyoutItem Text="Settings" Command="{x:Bind ViewModel.SettingsCommand}" />
            <MenuFlyoutItem Text="{x:Bind ViewModel.ToggleEffectsText, Mode=OneWay}" Command="{x:Bind ViewModel.ToggleEffectsCommand}" />
            <MenuFlyoutSeparator/>
            <MenuFlyoutItem Text="Exit" Command="{x:Bind ViewModel.ExitCommand}" />
        </MenuFlyout>
    </Page.ContextFlyout>
</Page>
